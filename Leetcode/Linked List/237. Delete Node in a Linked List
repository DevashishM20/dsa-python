class node:
    def __init__(self,value,next=None):
        self.value=value
        self.next=next

class SinglyLinkedList:
    def __init__(self):
        self.head=None
    def InsertAtEnd(self,value):
        nn=node(value)
        if self.head==None:
            self.head=nn
            return
        temp=self.head
        while temp.next != None:
            temp=temp.next
        temp.next=nn
    def deleteNode(self,node):
        node.val=node.next.val
        node.next=node.next.next
    def print(self):
        temp=self.head
        while temp != None:
            print(temp.value,end="->")
            temp=temp.next
        print(None)
