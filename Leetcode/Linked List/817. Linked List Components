class Node:
    def __init__(self,info,next=None):
        self.info=info
        self.next=next
class SinglyLL:
    def __init__(self,head=None):
        self.head=head
    def add(self,value):
        temp=Node(value)
        if self.head==None:
            self.head=temp
        else:
            t1=self.head
            while t1.next!=None:
                t1=t1.next
            t1.next=temp
    def SLLC(self):
        nums=set(nums)
        current=self.head
        count=0
        while current!=None:
            if current.info in nums:
                if current.next==None or current.next.info not in nums:
                    count+=1
            current=current.next
    def display(self):
        t1=self.head
        while t1!=None:
            print(t1.info)
            t1=t1.next
