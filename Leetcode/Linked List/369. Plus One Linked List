class Node:
    def __init__(self,info,next=None):
        self.info=info
        self.next=next
class SinglyLL:
    def __init__(self,head=None):
        self.head=head
    def add(self,value):
        temp=Node(value)
        if self.head==None:
            self.head=temp
        else:
            t1=self.head
            while t1.next!=None:
                t1=t1.next
            t1.next=temp
    def plus(self):
        prev=None
        current=self.head
        while current!=None:
            new_node=current.next
            current.next=prev
            prev=current
            current=new_node
        self.head=prev
        carry=1
        current=self.head
        while current!=None:
            total=current.info+carry
            current.info=total%10
            carry=total//10
            current=current.next
        if carry > 0:
            new_node = Node(carry)
            current = self.head
            while current.next != None:
                current = current.next
            current.next = new_node
        prev = None
        current = self.head
        while current != None:
            new_node = current.next
            current.next = prev
            prev = current
            current = new_node
        self.head = prev
    def display(self):
        t1=self.head
        while t1!=None:
            print(t1.info)
            t1=t1.next
a=SinglyLL()
a.add(1)
a.add(2)
a.add(9)
a.plus()
a.display()