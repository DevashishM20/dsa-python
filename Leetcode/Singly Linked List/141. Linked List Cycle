class node:
    def __init__(self,info,next=None):
        self.info=info
        self.next=next
class  SingleLinkedList:
    def __init__(self,head=None):
        self.head=head
    def insertAtEnd(self,value):
        temp=node(value)
        if(self.head != None):
            t1=self.head
            while t1.next != None:
                t1=t1.next
            t1.next=temp       
        else:
            self.head=temp
    def Cycle(self):
        slow=self.head
        fast=self.head
        while fast!=None and fast.next!=None:
            slow=slow.next
            fast=fast.next.next
            if slow==fast:
                return True
            else:
                return False
    def print(self):
        t1=self.head
        while t1 != None:
            print(t1.info)
            t1=t1.next
a=SingleLinkedList()
a.insertAtEnd(10)
a.insertAtEnd(20)
a.insertAtEnd(30)
a.print()
a.Cycle()
a.print()