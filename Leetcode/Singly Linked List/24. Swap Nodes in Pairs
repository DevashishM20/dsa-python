class Nodes:
    def __init__(self,info,next=None):
        self.info=info
        self.next=next
class SingleLL:
    def __init__(self,head=None):
        self.head=head
    def add(self,value):
        temp=Nodes(value)
        if self.head==None:
            self.head=temp
        else:
            t1=self.head
            while t1.next!=None:
                t1=t1.next
            t1.next=temp
    def display(self):
        t1=self.head
        while t1!=None:
            print(t1.info)
            t1=t1.next
    def swap(self):
        t1=self.head
        prev=None
        while t1!=None and t1.next!=None:
            first=t1
            second=t1.next
            first.next = second.next
            second.next=first
            if prev==None:
                self.head=second
            else:
                prev.next=second
            prev=first
            t1=first.next
