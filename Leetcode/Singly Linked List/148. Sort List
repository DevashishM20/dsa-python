class Nodes:
    def __init__(self,info,next=None):
        self.info=info
        self.next=next

class SinglyLL:
    def __init__(self,head=None):
        self.head=head
    def add(self,value):
        temp=Nodes(value)
        if self.head==None:
            self.head=temp
        else:
            t1=self.head
            while t1.next!=None:
                t1=t1.next
            t1.next=temp
    def sort(self,head):
        if head==None or head.next==None:
            return head
        slow=head
        fast=head
        prev=None
        while fast and fast.next:
            prev=slow
            slow=slow.next
            fast=fast.next.next
        prev.next=None
        left=self.sort(head)
        right=self.sort(slow)
        dummy = Nodes(0)
        temp = dummy
        while left != None and right != None:
            if left.val < right.val:
                temp.next = left
                left = left.next
            else:
                temp.next = right
                right = right.next
            temp = temp.next
        if left != None:
            temp.next = left
        else:
            temp.next = right
        return dummy.next

    def display(self):
        t1=self.head
        while t1!=None:
            print(t1.info)
            t1=t1.next
