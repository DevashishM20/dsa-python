class Nodes:
    def __init__(self,info,next=None):
        self.info=info
        self.next=next

class SinglyLL:
    def __init__(self,head=None):
        self.head=head
    def add(self,value):
        temp=Nodes(value)
        if self.head==None:
            self.head=temp
        else:
            t1=self.head
            while t1.next!=None:
                t1=t1.next
            t1.next=temp
    def InsertSort(self,head):
        if head == None or head.next == None:
            return head
        dummy = Nodes(0)
        dummy.next = head
        current = head.next
        while current != None:
            prev = dummy
            while prev.next.info < current.info:
                prev = prev.next
                if prev.next == current:
                    break
            next_node = current.next
            if prev.next != current:
                current.next = prev.next
                prev.next = current
            current = next_node
        return dummy.next

    def display(self):
        t1=self.head
        while t1!=None:
            print(t1.info)
            t1=t1.next
