class node:
    def __init__(self,value,next=None):
        self.value=value
        self.next=next

class SinglyLinkedList:
    def __init__(self):
        self.head=None
    def InsertAtEnd(self,value):
        nn=node(value)
        if self.head==None:
            self.head=nn
            return
        temp=self.head
        while temp.next != None:
            temp=temp.next
        temp.next=nn
    def reverseBetween(self, head, left, right):
        dummy=node(0)
        dummy.next=head
        prev=dummy
        for i in range(left-1):
            prev=prev.next
        current=prev.next
        for i in range(right-left):
            temp=current.next
            current.next=temp.next
            temp.next=prev.next
            prev.next=temp
        return dummy.next
    def print(self):
        temp=self.head
        while temp != None:
            print(temp.value,end="->")
            temp=temp.next
        print(None)
