from numpy import *
a=array([-1,0,1,2,-1,-4])
left=0
right=len(a)-1
b=[]
a.sort()
for i in range(len(a)-2):
    if i > 0 and a[i] == a[i-1]:
        continue
    left=i+1
    right=len(a)-1
    while left<right:
        total = a[i] + a[left] + a[right]
        if total==0:
            b.append([a[i], a[left], a[right]])
            left += 1
            right -= 1
        elif total<0:
            left+=1
        else:
            right-=1
print(b)
        