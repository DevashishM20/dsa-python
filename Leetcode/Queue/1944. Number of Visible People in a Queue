class Solution:
    def canSeePersonsCount(self,heights):
        n = len(heights)
        result=[0]*n
        stack=[]
        for i in range(n-1,-1,-1):
            count=0
            while stack and heights[stack[-1]]<heights[i]:
                stack.pop()
                count+=1
            if stack:
                count+=1
            result[i]=count
            stack.append(i)
        return result