class MyCircularDeque:
    def __init__(self,k):
        self.q=[0]*k
        self.k=k
        self.front=0
        self.count=0
    def insertFront(self,value):
        if self.isFull():
            return False
        self.front=(self.front-1)%self.k
        self.q[self.front]=value
        self.count+=1
        return True
    def insertLast(self,value):
        if self.isFull():
            return False
        rear=(self.front+self.count)%self.k
        self.q[rear]=value
        self.count+=1
        return True
    def deleteFront(self):
        if self.isEmpty():
            return False
        self.front=(self.front+1)%self.k
        self.count-=1
        return True
    def deleteLast(self):
        if self.isEmpty():
            return False
        self.count-=1
        return True
    def getFront(self):
        if self.isEmpty():
            return -1
        return self.q[self.front]
    def getRear(self):
        if self.isEmpty():
            return -1
        rear=(self.front+self.count-1)%self.k
        return self.q[rear]
    def isEmpty(self):
        return self.count==0
    def isFull(self):
        return self.count==self.k