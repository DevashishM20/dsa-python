class Solution(object):
    def shipWithinDays(self, weights, days):
        low = max(weights)
        high = sum(weights)
        while low<=high:
            mid=(low+high)//2
            current_weight=0
            required_days=1
            for weight in weights:
                if current_weight+weight>mid:
                    required_days+=1
                    current_weight=0
                current_weight+=weight
            if required_days<=days:
                high=mid-1
            else:
                low=mid+1
        return low